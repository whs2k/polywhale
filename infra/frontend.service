[Unit]
Description=PolyWhale Frontend Server
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/polywhale
ExecStart=/home/ubuntu/polywhale/venv/bin/python src/api.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=polywhale-frontend

[Install]
WantedBy=multi-user.target
