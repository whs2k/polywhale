[Unit]
Description=PolyWhale Frontend Server
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/polywhale/frontend
ExecStart=/home/ubuntu/polywhale/venv/bin/python -m http.server 8080
Restart=always
RestartSec=5
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=polywhale-frontend

[Install]
WantedBy=multi-user.target
